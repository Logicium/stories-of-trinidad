{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  // The SEO module's build-time half runs under Node; tsconfig.node.json checks it.
  "exclude": ["src/**/__tests__/*", "src/seo/node.ts", "src/seo/prerender.ts", "src/seo/browser.ts", "src/seo/expand.ts", "src/seo/vercel.ts"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["google.maps"],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
